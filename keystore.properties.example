# Release signing for local builds. Copy this file to keystore.properties
# (git-ignored, never committed) and fill it in, or set the environment
# variables PROXYFLOW_KEYSTORE_FILE, PROXYFLOW_KEYSTORE_PASSWORD,
# PROXYFLOW_KEY_ALIAS and PROXYFLOW_KEY_PASSWORD instead (CI: release.yml).
# Without either, assembleRelease produces an unsigned APK.
#
# The upload key is made by scripts/release/make_upload_key.sh, outside the
# repository (by default ~/ProxyFlow-release/proxyflow-upload.p12, alias
# proxyflow-upload, one password for the store and the key).
storeFile=/absolute/path/to/ProxyFlow-release/proxyflow-upload.p12
storePassword=
keyAlias=proxyflow-upload
keyPassword=
