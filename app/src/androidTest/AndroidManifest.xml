<?xml version="1.0" encoding="utf-8"?>
<!--
    The test APK only (never the app): a device owner for the CI emulators, so the M8 failure-injection run
    (scripts/m8_failure_injection.sh) can turn Android's Always-on VPN with "Block connections without VPN" on and off
    for ProxyFlow, as a user does in Android's VPN settings. Both receivers run in the test APK's own process, whose
    uid owns the admin; only the shell reaches the command receiver (it needs DUMP, which apps cannot get).
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <receiver
            android:name="app.proxyflow.e2e.LabDeviceAdmin"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/lab_device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>
        <receiver
            android:name="app.proxyflow.e2e.LabAdminCommands"
            android:exported="true"
            android:permission="android.permission.DUMP" />
    </application>
</manifest>
