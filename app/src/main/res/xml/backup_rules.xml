<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 10 and 11 read these rules instead of data_extraction_rules.xml.
  allowBackup="false" already turns backup off there; the rules say the same
  thing explicitly, so nothing is ever included in a backup (ADR-0006).
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
