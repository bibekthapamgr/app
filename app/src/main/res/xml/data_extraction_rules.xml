<?xml version="1.0" encoding="utf-8"?>
<!--
  Nothing leaves the phone in backups or device-to-device transfers (ADR-0006):
  proxy profiles, and from M3 the Keystore-encrypted passwords, whose key cannot
  be restored on another device anyway. allowBackup="false" covers Android 10–11;
  these rules cover Android 12+, where allowBackup alone does not stop transfers.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
